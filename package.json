{
  "name": "snz-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch backend/src/index.ts",
    "dev:client": "vite --config frontend/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config frontend/vite.config.ts",
    "build:server": "tsc -p backend/tsconfig.json",
    "check": "npm run check:client && npm run check:server",
    "check:client": "tsc -p frontend/tsconfig.json --noEmit",
    "check:server": "tsc -p backend/tsconfig.json --noEmit",
    "seed": "tsx backend/src/db/seed.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "remark-gfm": "^4.0.1",
    "tiny-segmenter": "^0.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
