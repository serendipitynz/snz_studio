# The desktop shell binds the loopback API port itself (fixed 127.0.0.1:8787 in
# `wails dev`, ephemeral in a packaged build) and reflects the WebView origin for
# CORS, so PORT / APP_ORIGIN are no longer read. The variables below are still
# honored by the Go config (internal/config, internal/bootstrap) as overrides.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
SQLITE_PATH=./data/app.sqlite

# OpenAI-compatible local endpoint
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=local-model
LLM_RESPONSE_FORMAT=standard
LLM_API_KEY=
LLM_TIMEOUT_MS=60000

# Optional review model endpoint
REVIEW_BASE_URL=http://127.0.0.1:1234/v1
REVIEW_MODEL=local-model

# Optional multimodal model that drafts an image document's description (derived
# text) from the image. Also editable in Settings. The endpoint falls back to
# LLM_BASE_URL when empty; the model does NOT fall back to LLM_MODEL (a text-only
# model would describe an image it never saw), so an empty model turns the
# "Generate description" action off.
IMAGE_DESCRIPTION_BASE_URL=
IMAGE_DESCRIPTION_MODEL=
# Longer than LLM_TIMEOUT_MS on purpose. Measured on LM Studio with
# google/gemma-4-12b-qat (reasoning on, Apple silicon): 64 s for an 800x500 PNG and
# 94 s for a 1024x1024 photo, most of it reasoning tokens. 180 s is about twice the
# slower case; the 60 s chat timeout would already have cut off both.
IMAGE_DESCRIPTION_TIMEOUT_MS=180000

# Embedding source: "internal" (bundled ruri-v3-30m via the llama.cpp sidecar,
# downloaded on first launch) or "external" (the OpenAI-compatible endpoint below).
# Defaults to internal; existing users with a non-empty EMBEDDING_MODEL migrate to
# external. In internal mode the EMBEDDING_BASE_URL/MODEL below are ignored (the
# sidecar endpoint is overlaid at runtime).
EMBEDDING_MODE=internal

# Dev override: absolute path to a llama-server binary for the internal sidecar.
# In a packaged app the binary is bundled (mac: Contents/Resources/llama-server,
# win: alongside the exe). Unset = sidecar disabled in dev unless a bundled binary
# is found, so internal mode degrades to FTS-only.
# SNZ_LLAMA_SERVER_BIN=/path/to/llama-server

# Optional external embedding endpoint for hybrid retrieval (used when EMBEDDING_MODE=external)
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_MS=60000

# Optional debug logs
DEBUG_CHAT_FLOW=0
DEBUG_RETRIEVAL=0
