# Apple notarization credentials for the release workflow.
#
# Copy this file to `.env.signing` (git-ignored), fill in the values, then run:
#     ./scripts/setup-ci-signing-secrets.sh path/to/DeveloperID.p12
#
# The script registers these three as GitHub Actions secrets, together with the
# certificate, its export password and its signing identity, which it reads
# from the .p12. Nothing in the app or in a local build reads this file:
# scripts/build-mac-signed.sh signs with the keychain identity and a notarytool
# profile instead.
#
# The Apple ID that owns the signing team, an app-specific password for it
# (appleid.apple.com > Sign-In and Security > App-Specific Passwords), and the
# 10-character team ID.
export APPLE_ID="you@example.com"
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"
export APPLE_TEAM_ID="XXXXXXXXXX"
