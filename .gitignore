node_modules
/dist
data
.DS_Store
.env
/sample-docs
.vscode

# Vite build output embedded by main.go; keep the placeholder so go:embed resolves.
frontend/dist/*
!frontend/dist/.gitkeep

# Wails build artifacts and generated bindings.
/build/bin
frontend/src/wailsjs

# Everything under build/windows/ is regenerated by a Windows `wails build`: icon.ico
# from appicon.png, info.json, the exe manifest, the WebView2 bootstrapper, and
# wails_tools.nsh (rewritten unconditionally every build, so tracking it would only
# dirty the tree). project.nsi is the exception the CLI reads back from disk when it
# exists, which is what makes our File directives for the notices stick.
/build/windows/*
!/build/windows/installer/
/build/windows/installer/*
!/build/windows/installer/project.nsi

# Per-OS llama-server sidecar binaries staged for dev/packaging (downloaded, large).
# Downloaded model GGUFs live under the (already-ignored) data dir at data/models.
/build/sidecar

# Working tree for scripts/build-ruri-gguf.sh (llama.cpp source/release, venv, HF
# snapshot, f16 intermediate — all large and regenerable).
/build/model-build

# pnpm's local content-addressable store (created by the workspace config).
.pnpm-store

# Claude Code's per-machine permission grants; not part of the project.
.claude/settings.local.json

# Personal scratch area for drafts. Was only in .git/info/exclude, which does not
# travel with a clone, so an accidental commit was one fresh checkout away.
/_sandbox
